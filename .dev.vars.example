# 复制为 .dev.vars 后 `wrangler dev` 会自动加载（此文件不要提交）
BOT_TOKEN=123456:AA-your-bot-token
# webhook 路径段 + Telegram secret_token，两处必须一致；建议 32 位以上随机串
WEBHOOK_SECRET=change-me-to-a-long-random-string
# 超管 Telegram user id，逗号分隔
ADMIN_IDS=123456789
# 可选：浏览器直接看审计页时用的 Bearer token
ADMIN_TOKEN=
# 可选：Mini App 绝对地址；留空则用 webhook 请求的 origin 自动推导
MINI_APP_URL=

# 可选：GitHub 验证门槛（不配也能用；配了才会调 api.github.com）
GITHUB_TOKEN=
GITHUB_MIN_ACCOUNT_AGE_DAYS=0
GITHUB_REQUIRED_ORG=

# 配置加密的根密钥（可选）：不填则用 BOT_TOKEN 派生
# 换掉它会让数据库里已加密的密钥失效，需要重新填一遍
SETTINGS_KEY=

# 以下配置现在也可以在网页「设置」里改，这里留空即可：
# MINI_APP_URL / VERIFY_TTL_SECONDS / VERIFY_DAILY_LIMIT / AUDIT_RETENTION_DAYS
# SCREEN_KEYWORDS / GITHUB_MIN_ACCOUNT_AGE_DAYS / GITHUB_REQUIRED_ORG
# GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_REDIRECT / GITHUB_TOKEN
# CAPTCHA_ENABLED / CAPTCHA_PROVIDER / CAPTCHA_URL / CAPTCHA_HOLD_HOURS
# TURNSTILE_SITE_KEY / TURNSTILE_SECRET / ALLOWED_BOTS
