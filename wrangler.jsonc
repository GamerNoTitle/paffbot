{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paffbot",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // 代码里统一用 env.DB，binding 必须叫 DB
      "binding": "DB",
      "database_name": "paffbot",
      "database_id": "6ed0080d-7496-432f-95e2-a500ddd2be1e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 每分钟扫一次超时的 pending 记录
    "crons": ["* * * * *"]
  },
  "vars": {
    // 非敏感配置；敏感值用 `wrangler secret put` 或 .dev.vars
    "VERIFY_TTL_SECONDS": "300",
    // 超管 Telegram user id（可跨群操作、看全量审计）
    "ADMIN_IDS": "1762053255",
    "ENVIRONMENT": "production"
  }
}
